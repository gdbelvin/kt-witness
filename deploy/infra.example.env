# Addresses of the machines this witness runs on.
#
# Copy to `.env` at the repository root and fill in real values. `.env` is
# gitignored: these are the operator's private network, and a public repository
# is the wrong place for them even though RFC1918 and CGNAT addresses are not
# routable from the internet. Nothing here is a credential; it is topology, and
# it is nobody else's business.
#
#     cp deploy/infra.example.env .env
#     $EDITOR .env
#
# Docker Compose reads `.env` from the project directory automatically. Every
# variable below is written `${VAR:?message}` at its use site, so Compose
# refuses to start when one is unset rather than substituting an empty string.
# That is deliberate and load-bearing — see KT_WITNESS_LAN_IP.

# The LAN address the witness binds the worker channel on.
#
# This is the security boundary. The work channel is an unauthenticated-ish gRPC
# endpoint that hands out verification assignments, and it must never be
# reachable from outside this network. Docker's host_ip in a port mapping is what
# confines it: `192.168.0.10:18090:8090` publishes on one interface, while
# `18090:8090` publishes on all of them.
#
# An empty value here would produce exactly the second form. That is why the use
# site is `${KT_WITNESS_LAN_IP:?...}` and not `${KT_WITNESS_LAN_IP}` — a missing
# .env must be a startup failure, never a silently internet-facing work queue.
KT_WITNESS_LAN_IP=192.168.0.10

# The GPU host, which serves Proton tree rebuilds over the same LAN.
KT_GPU_LAN_IP=192.168.0.11

# The tailnet this witness and its Grafana are reachable on, without the
# trailing .ts.net — used only in operational docs and dashboard upload scripts.
KT_TAILNET=example-tailnet

# What a remote worker should dial to fetch proofs — the witness host's LAN
# address and the canary port published in compose.yaml (18091, not the 8091 the
# container sees itself bound to).
#
# This one is read by the witness process rather than by Compose, because
# deploy/witness.json is mounted read-only from the repository and is therefore
# the deployed file; the address belongs here instead.
#
# Leaving it unset is FATAL, deliberately. The witness used to fall back to the
# address it bound inside its own namespace — 0.0.0.0 — which every worker
# resolves to its own loopback: the witness would start, log that it was serving
# proofs, hand out work, and fail every fetch, recording each epoch unverified
# and never firing a canary. A silent hole in the coverage is the one error this
# witness must not make, and "somebody forgot the env file" is a realistic
# Tuesday now that the address lives outside the repository.
KT_PROOF_HOST=192.168.0.10:18091
