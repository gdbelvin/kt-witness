# Signing keys must never be committed.
*.key

# The operator's live config, at the repo root only. Anchored: unanchored it
# also swallowed deploy/witness.json, so the staged deployment config was
# silently never committed.
/witness.json

# Local state.
*.db

# The built binary at the repo root — anchored, or it would also swallow the
# cmd/kt-witness source directory.
/kt-witness

# Rust sidecar build output (284MB proof temp files, target dir).
rust/**/target/

# Cloudflare Tunnel credentials authenticate the tunnel to Cloudflare. The
# config beside them is public; these are not.
/deploy/cloudflared/*.json
/secrets/

# The runtime volume: the witness key, the bolt database, and the tailnet node
# state. The last one is easy to overlook — it authenticates this node to the
# tailnet, so it is credential material even though nothing about the path says
# so. deploy/tailscale/serve.json is config and stays tracked; this is not.
/data/
