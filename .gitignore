# Signing keys must never be committed.
*.key

# The operator's live config, at the repo root only. Anchored: unanchored it
# also swallowed deploy/witness.json, so the staged deployment config was
# silently never committed.
/witness.json

# Local state.
*.db

# The built binary at the repo root — anchored, or it would also swallow the
# cmd/kt-witness source directory.
/kt-witness

# Rust sidecar build output (284MB proof temp files, target dir).
rust/**/target/

# Cloudflare Tunnel credentials authenticate the tunnel to Cloudflare. The
# config beside them is public; these are not.
/deploy/cloudflared/*.json
/secrets/

# The runtime volume: the witness key, the bolt database, and the tailnet node
# state. The last one is easy to overlook — it authenticates this node to the
# tailnet, so it is credential material even though nothing about the path says
# so. deploy/tailscale/serve.json is config and stays tracked; this is not.
/data/
.build-info

# Offline audit results, mirrored in from the GPU host. Data, not source.
/import/
.backfill-mirror/

# Compiled binaries. `/kt-witness` above was anchored for the witness itself,
# but the worker and the diff harness were missed and 43 MB of Mach-O went in
# — carrying /Users/<operator>/dev/kt-witness/... source paths from the build
# machine, which is not a credential but is not ours to publish either. Every
# one of these is reproducible from deploy/RUNBOOK.md.
/bin/
/kt-worker
/kt-akd-diff

# The operator's own network: which host holds the witness, which holds the
# GPU, which tailnet they are on. Not credentials — RFC1918 and CGNAT addresses
# are not routable from outside — but topology is nobody else's business, and it
# was scattered through compose files, flag defaults, tests and runbooks before
# this. Template and rationale in deploy/infra.example.env.
/.env
